extends SceneTree
const E = preload("res://src/niche_ecology.gd")

func _initialize() -> void:
    var s: Dictionary = E.origin()
    var pos: Vector3 = Vector3(-1100,0,-1100)
    assert(s.niches.size()==28)
    assert(E.niche_id(Vector3(1150,0,1150))=="24")
    E.register_birth(s,"a",pos,6)
    assert(not E.summary(s,"a",pos).dominant)
    E.register_birth(s,"a",pos,1)
    assert(E.summary(s,"a",pos).dominant)
    assert(is_equal_approx(E.summary(s,"a",pos).density,7/.2116))
    E.register_birth(s,"rival",pos,5)
    assert(E.summary(s,"a",pos).coexistence)
    E.register_birth(s,"a",pos,38)
    E.register_birth(s,"rival",pos,25)
    assert(E.summary(s,"a",pos).dominant) # 45 vs30, exactly1.5.
    assert(is_equal_approx(E.summary(s,"a",pos).density,45/.2116))
    E.register_birth(s,"rival",pos,1)
    assert(not E.summary(s,"a",pos).dominant)
    E.differentiate(s,"a","child",pos,2)
    assert(E.summary(s,"a",pos).population==43)
    assert(E.summary(s,"child",pos).population==2)
    assert(E.summary(s,"a",pos).total_population==76)
    var loaded: Dictionary = E.normalize(JSON.parse_string(JSON.stringify(s)))
    assert(loaded==E.normalize(loaded))
    assert(E.summary(loaded,"a",pos).population==43)
    var predator: Dictionary = {"attack":1.9,"motility":1.36,"vitality":1.44,"metabolism":.64,"uptake":.59,"defense":.96}
    var grazer: Dictionary = {"attack":.68,"defense":.61,"vitality":.92,"metabolism":1.57,"uptake":1.75}
    assert(E.climate_fit(predator,"prey_rich")>E.climate_fit(grazer,"prey_rich"))
    assert(E.climate_fit(grazer,"nutrient_mat")>E.climate_fit(predator,"nutrient_mat"))
    var pristine: Dictionary = E.origin()
    E.advance(pristine,600.0,{})
    assert(E.summary(pristine,"a",pos).total_population==0)
    var growth: Dictionary = E.origin()
    E.register_birth(growth,"a",pos,10)
    var clone: Dictionary = E.normalize(growth)
    for i in range(120):
        E.advance(growth,5.0,{"a":predator})
        E.advance(clone,5.0,{"a":predator})
    assert(growth==clone)
    assert(E.summary(growth,"a",pos).population>10)
    assert(E.summary(growth,"a",pos).total_population<=48)
    E.register_death(growth,"a",pos,9999)
    assert(E.summary(growth,"a",pos).population==0)
    print("PASS:25 persistent niches, exact density/dominance, competitor loss, save idempotence, differentiation conservation, climate counters, bounded deterministic ecological growth")
    quit(0)
